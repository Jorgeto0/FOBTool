	(text "UWB PDoA ANTENNA LAYOUT: \n	Place AE1 and AE2 on the same PCB edge with identical orientation. \n	Follow the Taoglas UWA.01 land pattern and maintain its 7.5 × 6.0 mm all-layer copper keepout for each antenna. \n	Route RF1 and RF2 as phase-matched 50 Ω traces with identical transitions and grounding. \n	Target antenna phase-centre spacing: 20.8 mm for channel 5 or 16.9 mm for channel 9 (0.45λ). \n	Confirm the primary PDoA channel before placement. \n	VNA-tune both networks and perform zero-angle PDoA calibration after assembly in the final enclosure."
		(exclude_from_sim no)
		(at 363.982 212.344 0)
		(effects
			(font
				(size 1.778 1.778)
				(thickness 0.3556)
				(bold yes)
				(color 132 0 0 1)
			)
			(justify left)
		)
		(uuid "edbdb2bf-91c1-4462-b6fe-b7e9d625a12d")
	)
