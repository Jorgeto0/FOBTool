	(text "FIRMWARE — SI4463 DIRECT/REPLAY MODE\n\n	If REPLAY_OUT is connected to GPIO0, configure GPIO0 as DIGITAL INPUT.\n	Set MODEM_MOD_TYPE.MOD_SOURCE for direct-mode modulation.\n	Keep the RF output disabled while changing the GPIO or modulation configuration.\n"
		(exclude_from_sim no)
		(at 78.994 151.892 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
				(color 128 77 0 1)
			)
		)
		(uuid "ab6a8921-fb38-4584-80f2-e3026221e861")
	)
	(text "FIRMWARE — PA2 FILTER CHANGE\n\nDeassert RFX_PA_EN_B before changing the post-PA filter selection.\nSelect one valid filter path, allow the control transaction and switch settling to complete, then enable PA2.\nNever switch post-PA filters during transmission.\n"
		(exclude_from_sim no)
		(at 391.16 135.382 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 128 77 0 1)
			)
		)
		(uuid "b6a9d145-c404-4530-bbba-3d9da53bcb9c")
	)
