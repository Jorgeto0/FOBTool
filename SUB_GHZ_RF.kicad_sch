	)
	(text "FIRMWARE — RF CONTROL STARTUP\n\n	Keep PA1 and PA2 disabled and both LNAs off at startup.\n	Write safe states to TCA9535 Output Port registers 0x02/0x03 before changing Configuration Port registers 0x06/0x07 from inputs to outputs.\n	Select the required RF path first; enable the selected LNA or PA last.\n	Exact output and configuration masks must follow the final U16 pin map.\n	Never change an RF switch, SAW path, or LPF path while a PA is enabled.\n"
		(exclude_from_sim no)
		(at 704.088 429.006 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
