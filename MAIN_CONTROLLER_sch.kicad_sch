	(text "I2C — R20/R21 are the only populated SDA/SCL pull-ups.\nDo not duplicate I2C pull-ups on peripheral sheets."
		(exclude_from_sim no)
		(at 46.99 123.19 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1f28cf25-32d4-46bc-9d77-139fcdb3dd62")
	)
	(text "ASSEMBLY — FIT ONLY ESP32-S3-WROOM-1-N16R2.\nDO NOT SUBSTITUTE N16R8/R16V: octal-PSRAM variants reserve GPIO35–37,\nwhich Rev-A uses for SPI_MOSI, SPI_SCK, and SPI_MISO."
		(exclude_from_sim no)
		(at 50.8 45.212 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "240c10cc-c85f-4a5b-a971-f3b760daeb88")
	)
	(text "PLACEMENT — Place 22uF and 100nF immediately beside U1 pin 2.\nPlace R19/C24 close to EN pin 3 and R18 close to GPIO0 pin 27.\nConnect pins 1, 40, and EPAD 41 directly to the solid GND plane."
		(exclude_from_sim no)
		(at 51.816 62.738 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "49337b3b-3bac-4504-8f6c-45de6cee2320")
	)
	(text "STRAPPING — GPIO0, GPIO45, and GPIO46 are sampled during reset.\nGPIO3 is also a strapping pin and remains unused.\nConnected peripherals must remain high-impedance during reset and must\nnot override the required strap levels."
		(exclude_from_sim no)
		(at 50.8 87.122 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7598becb-0364-486b-9180-b41abdad3696")
	)
	(text "BRING-UP — Provide accessible test pads/header access for +3V3, GND,\nESP_EN, ESP_BOOT/GPIO0, CONSOLE_TX/RX, and LINK_ESP_TX/RX/SYNC."
		(exclude_from_sim no)
		(at 50.292 133.604 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "77f9addc-a179-47d8-bea6-404d4a640687")
	)
	(text "UART — Place 499R immediately beside U1 pin 37.\nKeep CONSOLE_TX/RX short, ground-referenced, and away from the antenna."
		(exclude_from_sim no)
		(at 52.832 145.796 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9fcf7a27-2e0d-4e43-92dc-6f75bb392f2a")
	)
	(text "UART NET NAMES ARE FROM THE ESP32 PERSPECTIVE:\nCONSOLE_TX = U1 TXD0 -> CP2102N RXD\nCONSOLE_RX = CP2102N TXD -> U1 RXD0\nGPS_TX/RX and LINK_ESP_TX/RX follow the same ESP32-side convention."
		(exclude_from_sim no)
		(at 51.816 107.696 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e7564a1f-073f-49eb-b882-926b9c317fa8")
	)
	(text "LAYOUT — Place U1 at the PCB edge with its antenna facing outward.\nNo copper, tracks, vias, planes, or components are permitted inside the\nantenna keepout on any PCB layer. Keep switching nodes, USB/UART, SPI,\nbattery, shielding, and metal enclosure parts away from the antenna."
		(exclude_from_sim no)
		(at 52.578 28.956 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f62d8769-ad10-4b36-bae0-9b40456b10e6")
	)
